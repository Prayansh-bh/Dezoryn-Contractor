# PostgreSQL Connection URL
# Replace username, password, host, port, and dbname with your own credentials
DATABASE_URL="postgresql://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/dezoryn_db?schema=public"

# JWT Authentication (Set 64+ char random hex string in production)
JWT_ACCESS_SECRET="replace_with_a_secure_random_64_byte_hex_secret_key"

# CORS Configuration (Comma-separated allowed origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Initial Admin Provisioning (Used during db:seed)
INITIAL_ADMIN_EMAIL="admin@yourdomain.com"
INITIAL_ADMIN_PASSWORD="YourInitialAdminPassword123!"

