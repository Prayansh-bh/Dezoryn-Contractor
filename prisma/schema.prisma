generator client {
  provider      = "prisma-client-js"
  output        = "../backend/src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Enquiry {
  id        Int      @id @default(autoincrement())
  name      String
  company   String
  phone     String
  email     String
  product   String
  quantity  String
  location  String
  message   String   @default("")
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([status])
  @@map("enquiries")
}

model Product {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  kicker      String   @default("")
  description String
  imageUrl    String?  @map("image_url")
  features    Json     @default("[]")
  uses        Json     @default("[]")
  specs       Json     @default("[]")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@index([active])
  @@map("products")
}

model GalleryItem {
  id          Int      @id @default(autoincrement())
  title       String
  caption     String   @default("")
  mediaType   String   @map("media_type")
  objectKey   String   @unique @map("object_key")
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  fileData    Bytes?   @map("file_data")
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([active, featured, createdAt])
  @@index([createdAt])
  @@map("gallery_items")
}

model SiteSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model AdminUser {
  id                  Int                 @id @default(autoincrement())
  email               String              @unique
  passwordHash        String              @default("") @map("password_hash")
  name                String              @default("")
  role                String              @default("admin")
  tokenVersion        Int                 @default(0) @map("token_version")
  failedLoginAttempts Int                 @default(0) @map("failed_login_attempts")
  lockUntil           DateTime?           @map("lock_until")
  lastLoginAt         DateTime?           @map("last_login_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at")
  refreshTokens       AdminRefreshToken[]

  @@map("admin_users")
}

model AdminRefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id")
  isRevoked  Boolean   @default(false) @map("is_revoked")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  replacedBy String?   @map("replaced_by")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
  @@map("admin_refresh_tokens")
}
