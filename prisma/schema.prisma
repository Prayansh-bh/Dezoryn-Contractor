generator client {
  provider      = "prisma-client-js"
  output        = "../backend/src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Enquiry {
  id        Int      @id @default(autoincrement())
  name      String
  company   String
  phone     String
  email     String
  product   String
  quantity  String
  location  String
  message   String   @default("")
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([status])
  @@map("enquiries")
}

model Product {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  kicker      String   @default("")
  description String
  imageUrl    String?  @map("image_url")
  features    Json     @default("[]")
  uses        Json     @default("[]")
  specs       Json     @default("[]")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@index([active])
  @@map("products")
}

model GalleryItem {
  id          Int      @id @default(autoincrement())
  title       String
  caption     String   @default("")
  mediaType   String   @map("media_type")
  objectKey   String   @unique @map("object_key")
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  fileData    Bytes?   @map("file_data")
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([active, featured, createdAt])
  @@index([createdAt])
  @@map("gallery_items")
}

model SiteSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model AdminUser {
  id                  Int                 @id @default(autoincrement())
  email               String              @unique
  passwordHash        String              @default("") @map("password_hash")
  name                String              @default("")
  role                String              @default("admin")
  tokenVersion        Int                 @default(0) @map("token_version")
  failedLoginAttempts Int                 @default(0) @map("failed_login_attempts")
  lockUntil           DateTime?           @map("lock_until")
  lastLoginAt         DateTime?           @map("last_login_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at")
  refreshTokens       AdminRefreshToken[]

  @@map("admin_users")
}

model AdminRefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id")
  isRevoked  Boolean   @default(false) @map("is_revoked")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  replacedBy String?   @map("replaced_by")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
  @@map("admin_refresh_tokens")
}

model LabourRequisition {
  id              Int      @id @default(autoincrement())
  requisitionCode String   @unique @map("requisition_code")
  companyName     String   @map("company_name")
  contactPerson   String   @map("contact_person")
  phone           String
  email           String
  projectTitle    String   @map("project_title")
  projectType     String   @map("project_type")
  locationState   String   @map("location_state")
  locationCity    String   @map("location_city")
  siteAddress     String?  @map("site_address")
  totalWorkers    Int      @map("total_workers")
  skillsRequired  Json     @default("[]") @map("skills_required")
  startDate       String?  @map("start_date")
  durationMonths  String?  @map("duration_months")
  amenities       Json     @default("[]")
  dailyWageBudget String?  @map("daily_wage_budget")
  message         String?  @default("")
  status          String   @default("open")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([locationState])
  @@map("labour_requisitions")
}

model LabourAgency {
  id              Int      @id @default(autoincrement())
  agencyCode      String   @unique @map("agency_code")
  agencyName      String   @map("agency_name")
  proprietorName  String   @map("proprietor_name")
  phone           String   @unique
  email           String?
  gstin           String?
  labourLicenseNo String?  @map("labour_license_no")
  state           String
  city            String
  totalCrewSize   Int      @map("total_crew_size")
  primaryTrades   Json     @default("[]") @map("primary_trades")
  preferredStates Json     @default("[]") @map("preferred_states")
  availability    String   @default("immediate")
  verified        Boolean  @default(false)
  status          String   @default("active")
  notes           String?  @default("")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([status, verified])
  @@index([state])
  @@map("labour_agencies")
}

model IndividualWorker {
  id              Int      @id @default(autoincrement())
  workerCode      String   @unique @map("worker_code")
  fullName        String   @map("full_name")
  phone           String   @unique
  trade           String
  experienceYears Int      @default(1) @map("experience_years")
  currentCity     String   @map("current_city")
  currentState    String   @map("current_state")
  dailyWageExpect String?  @map("daily_wage_expect")
  canRelocate     Boolean  @default(true) @map("can_relocate")
  availability    String   @default("immediate")
  verified        Boolean  @default(false)
  status          String   @default("available")
  notes           String?  @default("")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([trade, currentState])
  @@index([status])
  @@map("individual_workers")
}

model Certificate {
  id            Int      @id @default(autoincrement())
  title         String
  subtitle      String?  @default("")
  issuer        String   @default("")
  certificateNo String?  @map("certificate_no")
  validUntil    String?  @map("valid_until")
  imageUrl      String   @map("image_url")
  fileName      String?  @map("file_name")
  fileData      Bytes?   @map("file_data")
  contentType   String?  @map("content_type")
  active        Boolean  @default(true)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([active, sortOrder])
  @@index([createdAt])
  @@map("certificates")
}


